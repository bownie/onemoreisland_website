---
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@/i18n";
import config from "@/config";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";

const { site } = config;
const { titleOverride }: { titleOverride?: string } = Astro.props;
const headerTitle = titleOverride ?? site.shortTitle ?? site.title;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-50 px-3 py-2 backdrop-blur-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header class="app-layout island-header">
  <div class="island-header-inner">
    <div class="island-header-left">
      <button
        id="theme-btn"
        type="button"
        class="island-header-theme"
        aria-label="Toggle theme"
        title="Toggle theme"
      >
        <IconSunHigh class="island-header-icon island-header-icon-sun" />
        <IconMoon class="island-header-icon island-header-icon-moon" />
      </button>
      <a href={getRelativeLocaleUrl(locale, "")} class="island-header-title">{headerTitle}</a>
    </div>
    <a href={getRelativeLocaleUrl(locale, "about")} class="island-header-about">{t.nav.about}</a>
  </div>
</header>
