---
const {
  title = "Join the newsletter",
  description = "Stay updated with new writing, book news, and more.",
} = Astro.props;
---

<section
  class="newsletter-signup border-border bg-background grid gap-6 border p-8 sm:p-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-center"
>
  <div>
    <h2 class="text-foreground text-xl">{title}</h2>
    <p class="text-muted-foreground mt-2 text-sm leading-7">{description}</p>
  </div>
  <div class="ml-embedded w-full lg:justify-self-end" data-form="S0sPwI"></div>
</section>

<style>
  :global(.ml-embedded form) {
    margin: 0 !important;
  }
</style>

<script>
  let emailLabelObserver: MutationObserver | undefined;

  const addEmailLabels = (root: ParentNode) => {
    root
      .querySelectorAll<HTMLInputElement>('input[type="email"]')
      .forEach(input => {
        if (input.labels?.length) return;
        if (!input.id) input.id = "island-newsletter-email";

        const label = document.createElement("label");
        label.className = "newsletter-email-label";
        label.htmlFor = input.id;
        label.textContent = "Email";
        input.before(label);
      });
  };

  const observeNewsletterForm = () => {
    emailLabelObserver?.disconnect();
    const root = document.querySelector(".island-signup .ml-embedded");
    if (!root) return;

    addEmailLabels(root);
    emailLabelObserver = new MutationObserver(() => addEmailLabels(root));
    emailLabelObserver.observe(root, { childList: true, subtree: true });
  };

  document.addEventListener("astro:page-load", observeNewsletterForm);
  observeNewsletterForm();
</script>

<script is:inline>
  (function (w, d, e, u, f, l, n) {
    w[f] =
      w[f] ||
      function () {
        (w[f].q = w[f].q || []).push(arguments);
      };
    l = d.createElement(e);
    l.async = 1;
    l.src = u;
    n = d.getElementsByTagName(e)[0];
    n.parentNode.insertBefore(l, n);
  })(
    window,
    document,
    "script",
    "https://assets.mailerlite.com/js/universal.js",
    "ml"
  );
  ml("account", "2727806");
</script>
