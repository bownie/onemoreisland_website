---
const {
  title = "Join the newsletter",
  description = "Stay updated with new writing, book news, and more.",
} = Astro.props;

// MailerLite embed endpoint for account 2727806, form S0sPwI.
// Posting to it directly means the form works without MailerLite's
// universal.js, which some browsers and ad blockers prevent from loading.
const endpoint =
  "https://assets.mailerlite.com/jsonp/2727806/forms/201864919215245018/subscribe";
---

<section
  class="newsletter-signup border-border bg-background grid gap-6 border p-8 sm:p-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-center"
>
  <div>
    <h2 class="text-foreground text-xl">{title}</h2>
    <p class="text-muted-foreground mt-2 text-sm leading-7">{description}</p>
  </div>
  <div class="w-full lg:justify-self-end">
    <form
      class="newsletter-form"
      method="post"
      action={endpoint}
      data-endpoint={endpoint}
    >
      <div class="newsletter-field">
        <label class="newsletter-email-label" for="newsletter-email">
          Email address
        </label>
        <input
          id="newsletter-email"
          type="email"
          name="fields[email]"
          placeholder="Your email address"
          autocomplete="email"
          inputmode="email"
          required
        />
      </div>

      <div class="newsletter-honeypot" aria-hidden="true">
        <label for="newsletter-website">Leave this field empty</label>
        <input
          id="newsletter-website"
          type="text"
          name="website"
          tabindex="-1"
          autocomplete="off"
        />
      </div>

      <label class="newsletter-consent">
        <input type="checkbox" id="newsletter-consent" required />
        <span>
          Yes, email me occasional news about <em>One More Island</em> and
          Richard Bown's writing. I understand I can unsubscribe at any time.
          See the <a href="/privacy/">privacy policy</a>.
        </span>
      </label>

      <input type="hidden" name="ml-submit" value="1" />
      <input type="hidden" name="anticsrf" value="true" />

      <button type="submit">Subscribe</button>

      <p class="newsletter-status" role="status" aria-live="polite"></p>

      <p class="newsletter-fineprint">
        You can unsubscribe anytime. For more details, review our
        <a href="/privacy/">Privacy Policy</a>.
      </p>
    </form>
  </div>
</section>

<style>
  .newsletter-form button[type="submit"] {
    margin: 0;
  }
</style>

<script>
  const submitHandler = async (event: SubmitEvent) => {
    const form = event.target as HTMLFormElement | null;
    if (!form?.matches?.(".newsletter-form")) return;

    event.preventDefault();

    const status = form.querySelector<HTMLElement>(".newsletter-status");
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const email = form.querySelector<HTMLInputElement>('input[type="email"]');
    const honeypot = form.querySelector<HTMLInputElement>('input[name="website"]');
    const endpoint = form.dataset.endpoint || form.getAttribute("action") || "";

    if (!endpoint || !email || !button || !status) return;
    if (honeypot?.value) return;

    if (!form.reportValidity()) return;

    const setStatus = (message: string, state: "success" | "error") => {
      status.textContent = message;
      status.dataset.state = state;
    };

    setStatus("", "success");
    button.disabled = true;
    const originalLabel = button.textContent;
    button.textContent = "Subscribing…";

    const body = new URLSearchParams();
    body.set("fields[email]", email.value.trim());
    body.set("ml-submit", "1");
    body.set("anticsrf", "true");

    try {
      const response = await fetch(endpoint, {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body,
      });

      const payload = await response.json().catch(() => null);

      if (response.ok && payload?.success) {
        form.reset();
        setStatus(
          "Thanks — check your inbox to confirm your subscription.",
          "success"
        );
        return;
      }

      const message =
        payload?.errors?.fields?.email?.[0] ??
        payload?.errors?.message ??
        "That didn't work. Please check your email address and try again.";
      setStatus(message, "error");
    } catch {
      setStatus(
        "Sorry, we couldn't reach the mailing list. Please try again in a moment.",
        "error"
      );
    } finally {
      button.disabled = false;
      button.textContent = originalLabel;
    }
  };

  const w = window as typeof window & { __newsletterSubmitBound?: boolean };
  if (!w.__newsletterSubmitBound) {
    w.__newsletterSubmitBound = true;
    document.addEventListener("submit", submitHandler);
  }
</script>
