---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import NewsletterSignup from "@/components/NewsletterSignup.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header showHomeLinks />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout island-home"
  >
    <section class="island-hero" aria-labelledby="hero-title">
      <img src="/contours.svg" alt="" class="island-contours" />
      <div class="island-hero-grid">
        <div>
          <p class="island-eyebrow">From the author of Human Software</p>
          <h1 id="hero-title">It's never too late to <em>start again.</em></h1>
          <p class="island-subtitle">
            Peter Watchett ran to Sandport to escape the life he built in
            London. Now his estranged brother is back, and the past is catching
            up.
          </p>
          <a class="island-button" href="#signup">Join the readers' list</a>
          <p class="island-when">Coming early 2027</p>
        </div>
        <img
          src="/one-more-island-cover-v2.2.jpg"
          alt="One More Island book cover"
          class="island-cover"
        />
      </div>
    </section>

    <section id="story" class="island-story" aria-labelledby="story-title">
      <div class="island-story-heading">
        <h2 id="story-title">The story</h2>
        <h3>A place that already knows you</h3>
      </div>
      <div class="island-story-copy">
        <p class="lead">
          Peter Watchett keeps telling himself that he's happy. He ran to
          Sandport to escape a life that he didn't like anymore. He escaped a
          person that he didn't want to be. But secrets don't keep in a place
          that already knows you, and when Peter's estranged brother comes back
          into town, he must confront the past and decide whether he keeps
          running or finally start to build a new life.
        </p>
        <blockquote class="island-pull-quote">
          An overlooked old man, moving deliberately from room to room, fixing
          the things that break.
        </blockquote>
      </div>
    </section>

    <section id="signup" class="island-signup" aria-labelledby="signup-title">
      <h2 id="signup-title">Sign up to stay informed</h2>
      <p>
        Join my newsletter for writing updates, publication news and
        opportunities to become an early ARC reader.
      </p>
      <NewsletterSignup
        title="Sign up for updates"
        description="Get book news, writing updates, and launch information straight to your inbox."
      />
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
