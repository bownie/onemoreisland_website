---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import NewsletterSignup from "@/components/NewsletterSignup.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout island-home"
  >
    <section class="island-hero" aria-labelledby="hero-title">
      <img src="/contours.svg" alt="" class="island-contours" />
      <div class="island-hero-grid">
        <div>
          <p class="island-eyebrow">From the author of Human Software</p>
          <h1 id="hero-title">It's never too late to <em>start again.</em></h1>
          <p class="island-subtitle">
            Peter Watchett ran to Sandport to escape the life he built in
            London. Now his estranged brother is back, and the past is catching
            up.
          </p>
          <a
            class="island-button bg-accent text-accent-foreground inline-block rounded-full px-6 py-3 font-bold"
            href="#join">Join the readers' list</a
          >
          <p class="island-when">Coming early 2027</p>
        </div>
        <img
          src="/one-more-island-cover-v2.png"
          alt="One More Island book cover"
          class="island-cover"
        />
      </div>
    </section>

    <section class="py-16 sm:py-20" aria-labelledby="story-title">
      <div class="island-story">
        <p class="island-eyebrow">The story</p>
        <h2 id="story-title">A place that already knows you</h2>
        <p class="lead">
          Peter Watchett feels old and alone. He ran to Sandport to escape the
          life he'd built for himself in London, but secrets don't keep in a
          place that already knows you. When Peter's estranged brother walks
          back into town, he must confront the hidden truth and decide whether
          he keeps running or finally start to build a new life for himself.
        </p>
        <p>
          Set in Sandport on the Kent coast, <b>One More Island</b> is a novel about
          family, identity, regret and the fragile hope of another chance.
        </p>
        <p>
          As old relationships resurface, Peter must face the stories he has
          lived by and the questions he has long avoided. Starting again does
          not mean changing the past, but finding something worth holding on to.
        </p>
      </div>
    </section>

    <section
      id="join"
      class="island-signup mb-16 sm:mb-20"
      aria-labelledby="join-title"
    >
      <h2 id="join-title">Sign up to stay informed</h2>
      <p>
        Join my newsletter for writing updates, publication news and
        opportunities to become an early ARC reader.
      </p>
      <NewsletterSignup
        title="Sign up for updates"
        description="Get book news, writing updates, and launch information straight to your inbox."
      />
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
